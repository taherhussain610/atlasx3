{
  "name": "crypto-exchange-app",
  "version": "1.0.0",
  "description": "Multi-currency crypto wallet and exchange demo app",
  "main": "src/server.js",
  "scripts": {
    "start": "node ./scripts/stop.js && node src/server.js",
    "dev": "node ./scripts/stop.js && nodemon src/server.js",
    "build": "npm run hardhat:compile",
    "hardhat:compile": "cd hardhat && ./node_modules/.bin/hardhat compile",
    "hardhat:clean": "cd hardhat && ./node_modules/.bin/hardhat clean",
    "hardhat:node": "cd hardhat && ./node_modules/.bin/hardhat node",
    "hardhat:smoke": "cd hardhat && ./node_modules/.bin/hardhat run scripts/smoke.js",
    "hardhat:deploy": "cd hardhat && ./node_modules/.bin/hardhat run scripts/deploy.js",
    "hardhat:deploy:atlasx": "cd hardhat && ./node_modules/.bin/hardhat run scripts/deploy.js --network atlasx",
    "smoke": "powershell -ExecutionPolicy Bypass -File ./scripts/smoke.ps1",
    "stop": "node ./scripts/stop.js",
    "test": "node --test tests/*.test.js",
    "test:ui": "node tests/ui-smoke.js",
    "lint": "eslint \"src/**/*.js\" \"public/**/*.js\" \"scripts/**/*.js\" \"tests/**/*.js\" \"*.js\"",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"eslint.config.js\" \"package*.json\" \"tests/**/*.js\" \"src/services/{emailService,paymentTerminalService}.js\" \"{EMAIL_INTEGRATION,PAYMENT_TERMINAL_INTEGRATION,QUICK_COMMANDS}.md\"",
    "format:check": "prettier --check \"eslint.config.js\" \"package*.json\" \"tests/**/*.js\" \"src/services/{emailService,paymentTerminalService}.js\" \"{EMAIL_INTEGRATION,PAYMENT_TERMINAL_INTEGRATION,QUICK_COMMANDS}.md\"",
    "check": "npm run lint && npm run format:check && npm run hardhat:smoke && npm test && npm run smoke && npm run test:ui && npm audit --omit=dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@solana/web3.js": "^1.98.4",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "bip39": "^3.1.0",
    "bs58": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "coingecko-api": "^1.0.10",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "moment": "^2.30.1",
    "morgan": "^1.11.0",
    "nodemailer": "^9.0.3",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3",
    "tronweb": "^6.4.0",
    "uuid": "^14.0.1",
    "validator": "^13.15.35",
    "web3": "^4.16.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nomicfoundation/hardhat-ethers": "^4.0.15",
    "@types/mocha": "^10.0.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "hardhat": "^3.13.0",
    "nodemon": "^3.1.14",
    "playwright-core": "^1.62.1",
    "prettier": "^3.9.6",
    "solc": "0.8.28"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "bufferutil@4.1.0": true,
    "utf-8-validate@6.0.6": true
  },
  "overrides": {
    "ethers": "$ethers",
    "jayson": {
      "uuid": "^11.1.1",
      "ws": "^8.21.3"
    },
    "solc": {
      "tmp": "0.2.7"
    }
  }
}
